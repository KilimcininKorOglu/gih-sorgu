# GİH Sorgu Aracı - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Google Gemini API Anahtarı
# https://aistudio.google.com/app/apikey adresinden alabilirsiniz
GEMINI_API_KEY=your_api_key_here

# Gemini Model Adı (opsiyonel, varsayılan: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini Max Output Tokens (opsiyonel, varsayılan: 256)
GEMINI_MAX_TOKENS=256

# User Agent (opsiyonel, varsayılan: modern bir tarayıcı user agent'ı)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:145.0) Gecko/20100101 Firefox/145.0

# Sorgular arası bekleme, milisaniye (opsiyonel, varsayılan: 500)
RATE_LIMIT_DELAY=500
